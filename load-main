-- 1. KIỂM TRA ĐỒNG BỘ AUTO-KEY TRƯỚC KHI TẠO GUI
-- ==========================================
local isKeyValidAndLoaded = false

if checkFile and checkFile(KEY_FILE) then
    local successRead, rawData = pcall(loadFile, KEY_FILE)
    if successRead and rawData ~= "" then
        local savedKey = decryptKey(rawData)
        local httpRequest = http_request or request or (syn and syn.request) or (fluxus and fluxus.request)
        if httpRequest and savedKey ~= "" then
            local success, res = pcall(function()
                return httpRequest({
                    Url = RENDER_URL .. "/verify?hwid=" .. HWID .. "&key=" .. savedKey,
                    Method = "GET"
                })
            end)
            if success and res and res.Body then
                local successDecode, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
                if successDecode and data and data.status == "success" and data.scriptUrl then
                    isKeyValidAndLoaded = true
                    game:GetService("StarterGui"):SetCore("SendNotification", {
                        Title = "Pitaya Hub",
                        Text = "✅ Auto-Key thành công! Đang tải Script...",
                        Duration = 3
                    })
                    task.wait(0.5)
                    loadstring(game:HttpGet(data.scriptUrl))()
                end
            end
        end
    end
end

