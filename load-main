-- HÀM MÃ HÓA & GIẢI MÃ BẰNG HWID + FILE SAVER
local KEY_FILE = "Pitaya_Key.dat"
local saveFile = writefile or (syn and syn.writefile)
local loadFile = readfile or (syn and syn.readfile)
local checkFile = isfile or (syn and syn.isfile)

local function encryptKey(str)
    local result = {}
    for i = 1, #str do
        local keyByte = string.byte(HWID, (i - 1) % #HWID + 1)
        local strByte = string.byte(str, i)
        table.insert(result, string.format("%02X", bit32.bxor(strByte, keyByte)))
    end
    return table.concat(result)
end

local function decryptKey(hexStr)
    local bytes = {}
    for i = 1, #hexStr, 2 do
        local hex = string.sub(hexStr, i, i + 1)
        local byteVal = tonumber(hex, 16)
        if byteVal then
            local keyByte = string.byte(HWID, ((i + 1) / 2 - 1) % #HWID + 1)
            table.insert(bytes, string.char(bit32.bxor(byteVal, keyByte)))
        end
    end
    return table.concat(bytes)
end

